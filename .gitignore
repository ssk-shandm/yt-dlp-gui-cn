*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage*
htmlcov/

# Vue / Vite / Node.js
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
