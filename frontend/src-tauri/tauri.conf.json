{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp GUI",
  "version": "2.0.0",
  "identifier": "com.ssk-shandm.ytdlp-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run tools:check && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp GUI 中文版",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost http: https: data: blob:; connect-src ipc: http://ipc.localhost https://api.github.com https://github.com https://*.githubusercontent.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../../bin/yt-dlp.exe": "bin/yt-dlp.exe",
      "../../bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../../bin/ffprobe.exe": "bin/ffprobe.exe",
      "../../LICENSE": "LICENSE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
