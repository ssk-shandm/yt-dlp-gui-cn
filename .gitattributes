# GitHub Linguist: count only Rust, JavaScript and Vue in language statistics.
# This affects statistics only; other source files remain tracked and usable.
* -linguist-detectable
*.rs linguist-detectable
*.js linguist-detectable
*.mjs linguist-detectable
*.cjs linguist-detectable
*.vue linguist-detectable

# Third-party notices, source excerpts and archives are redistribution materials,
# not application code. Preserve their exact bytes and exclude them from stats.
/licenses/** linguist-vendored -linguist-detectable -text
